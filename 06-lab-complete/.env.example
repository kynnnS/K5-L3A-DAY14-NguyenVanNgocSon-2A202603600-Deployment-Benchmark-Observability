# ============================================================
# Biến môi trường của agent — KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env   (file .env đã nằm trong .gitignore)
# Trên Railway/Render: đặt các biến này trong dashboard của nền tảng.
# ============================================================

# Cổng HTTP (Railway/Render tự cấp PORT, không cần đặt trên cloud)
PORT=8000
# development | staging | production
ENVIRONMENT=development

# Secret: key client gửi qua header X-API-Key. Tạo key ngẫu nhiên, vd:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me

# Redis lưu state rate limit + chi phí (docker compose tự ghi đè thành redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Số request tối đa / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10
# Ngân sách LLM mỗi ngày (USD, theo UTC); vượt → 402
DAILY_BUDGET_USD=1.0

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
